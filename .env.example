# Salin ke .env.local. Jangan commit nilai asli.

# Supabase. Untuk pengembangan lokal: jalankan `pnpm db:start`, lalu salin
# API URL, publishable key, dan secret key dari keluarannya.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hanya server. Melewati RLS. Jangan diberi awalan NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Sentry (opsional). Kosong = Sentry tidak aktif.
NEXT_PUBLIC_SENTRY_DSN=

# URL dasar situs untuk link di email dan redirect OAuth. Wajib diisi di produksi.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email undangan anggota lewat Resend (opsional). Kosong = link ditampilkan
# untuk disalin, email tidak dikirim.
RESEND_API_KEY=
EMAIL_FROM=
